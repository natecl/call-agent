# Copy to .env and fill in to use live backends. All values are optional:
# without credentials the app runs with in-process mock backends so the full
# call flow still works end-to-end.

# HTTP server
PORT=3000
HOST=0.0.0.0

# Public wss host Telnyx should stream media to (no scheme), e.g. an ngrok host.
# PUBLIC_HOST=your-subdomain.ngrok.app

# Telnyx Call Control
# TELNYX_API_KEY=KEY...
# TELNYX_PUBLIC_KEY=...
# TELNYX_STREAM_TRACK=inbound_track

# OpenAI GPT-Live (Realtime API)
# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-realtime
# OPENAI_VOICE=marin

# Agent persona
# SYSTEM_PROMPT=You are a friendly, concise consumer phone assistant.
# GREETING=Hi! Thanks for calling. How can I help you today?

# Force a backend (auto|openai|mock) / (auto|live|mock). "auto" picks based on
# whether the matching credentials are present.
# REALTIME_BACKEND=auto
# TELNYX_BACKEND=auto
